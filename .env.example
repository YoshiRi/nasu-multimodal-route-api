# scripts/download_gtfs.py configuration.
#
# nasushiobara / nasutown are public feeds with a non-secret URL baked
# into scripts/download_gtfs.py — no env var needed for them normally.
#
# kanto_auto requires an API key issued by the data provider (PTD-HS).
# The key is the only secret; the endpoint and agency_id are public and
# live in source.
KANTO_BUS_GTFS_API_KEY=

# Optional overrides (e.g. to point a feed at a local test server, or
# swap in a different URL without touching source). Leave unset to use
# the defaults above.
NASUSHIOBARA_GTFS_URL=
NASUTOWN_GTFS_URL=
KANTO_BUS_GTFS_URL=
